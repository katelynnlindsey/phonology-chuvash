# NOTE: git only recognises "/" as a path separator. The earlier version of
# this file used Windows backslashes, so none of the audio-exclusion rules
# below were actually in effect.

# ── R session state ──────────────────────────────────────────────
# .RData auto-loads into the global environment on project open, which
# silently resurrects objects from a previous session and makes results
# depend on session history. Never commit it.
.RData
.Rhistory
.Rapp.history
.Rproj.user/
*.Rproj.user

# ── OS cruft ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Large media: regenerable from the source corpora ─────────────
corpora/textgrids_commonvoice/*.mp3
corpora/textgrids_commonvoice/*.wav
corpora/textgrids_commonvoice/*.lab
*.mp3
*.wav

# ── Large source data: re-downloadable from HuggingFace ──────────
1-raw_data/monolingual_chuvash/*.parquet
1-raw_data/chuvash_voice/audio_transcripts/*.parquet

# ── Stage 7/8 extraction outputs: large and regenerable ──────────
# 3.2 GB total. Regenerate with the stage-7 scripts; the pipeline reads
# them into 9-analyze/data/loaded/*.rds, which IS version-controlled
# (via git-lfs), so the analysis is reproducible without them.
#   contours_output.csv (Common Voice) alone is 1.4 GB
7-extract/contours/vowels/*/contours_output.csv
7-extract/contours/words_phrases/output-words.csv
7-extract/contours/words_phrases/output-phrases.csv
8-combine/all_chuvash_vowel_points.csv

# ── Duplicate of 1-raw_data/chuvash_voice/audio_transcripts/ ─────
# Verified byte-identical with cmp (1.3 GB). Kept out of git; safe to
# delete from disk once confirmed unneeded.
/data/

# ── Overnight 2026-10-01 run: regenerable caches ─────────────────
# Column-subset exports and per-phone Praat extractions re-created by the
# scripts in 9-analyze/analyses/overnight/. Four files exceed GitHub's
# 100 MB limit (mono_raw.parquet 188 MB, raw_vowels_compact.csv 153 MB,
# phones_ch_part00/01.csv ~105 MB each). Kept on disk; not versioned.
9-analyze/output/overnight_2026-10-01/*/cache/
9-analyze/output/overnight_2026-10-01/*/intermediate/
9-analyze/output/overnight_2026-10-01/segmental_acoustics/extraction/

# ── Speaker-cues 2026-10-02: regenerable model-frame cache ───────
# Rebuilt by 9-analyze/analyses/speaker_cues/models/00_model_frame.R
9-analyze/output/speaker_cues_2026-10-02/*/cache/

# ── Scratch ──────────────────────────────────────────────────────
old/
9-analyze/config/new.txt

# Large pipeline outputs, kept local only
7-extract/reextract/phones_chuvash_voice.csv
9-analyze/output/align_confidence.csv
9-analyze/output/vowels_for_confidence.csv
9-analyze/output/vowels_normalised.csv
