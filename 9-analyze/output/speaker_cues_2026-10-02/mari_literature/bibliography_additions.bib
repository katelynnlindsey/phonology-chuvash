@phdthesis{Vaysman2009_vaysman2009,
  author = {Vaysman, Olga},
  title = {Segmental Alternations and Metrical Theory},
  school = {Massachusetts Institute of Technology},
  year = {2009},
  type = {PhD dissertation},
  url = {http://hdl.handle.net/1721.1/47830},
  note = {Verified via MIT DSpace item record and full-text PDF; no DOI. Eastern Mari case study \S 2.3, pp. 60--96; stress \S 2.3.1, pp. 62--77},
  annote = {[content checked] Fieldwork dialect on the Nizhny Novgorod--Mari El border (2002). Underived words: rightmost underlying full vowel, else leftmost (p. 62--65); underlying schwas that vocalise word-finally still count as reduced (p. 63 fn 21). Suffixes are morphologically conditioned: full-vowel suffixes do not take stress from full-vowel roots, /a/-suffixes beat /e/-suffixes after full+schwa roots, all-schwa roots lose stress to any full-vowel suffix, schwa and harmonising o/ö/e suffixes are never stressed (pp. 69--73). Cues: f0, amplitude and especially duration, +c.120 ms on a 70 ms vowel (p. 62); impressionistic, no measurement method given. Footnote 22 (p. 64) rejects a Dobrovolsky-style stressless default for this dialect.}
}

@article{Lehiste2005_lehiste2005_read,
  author = {Lehiste, Ilse and Teras, Pire and Help, Toomas and Lippus, P{\"a}rtel and Meister, Einar and Pajusalu, Karl and Viitso, Tiit-Rein},
  title = {Meadow Mari Prosody},
  journal = {Linguistica Uralica, Supplementary Series},
  volume = {2},
  year = {2005},
  pages = {1--142},
  publisher = {Estonian Academy Publishers},
  address = {Tallinn},
  doi = {10.3176/lu.2005.2s},
  note = {DOI verified via CrossRef; ISBN 9985-50-387-2},
  annote = {[content checked] 8 speakers (4 F, 4 M; born 1963--1981; 6 from Mari El, 1 Bashkortostan, 1 Perm), 100 test words of 1--4 syllables in the frame `I said ..., not ...', phrase- and sentence-final, 1600 tokens; stress location judged by one native listener. Duration is the most reliable stress correlate but is outweighed by final lengthening; F0 is auxiliary and overridden by sentence intonation; unstressed vowels centralise (mostly < 1 Bark). Intensity was not measured (p. 93). All-central-vowel words: initial stress (p. 94).}
}

