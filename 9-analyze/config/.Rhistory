cat("\n── A. Spoken corpora ──\n")
raw_vowels <- read_csv(PATHS$vowel_points_csv,
locale = locale(encoding = "UTF-8"),
show_col_types = FALSE) %>%
note_n("A1: raw vowel_points CSV loaded")
